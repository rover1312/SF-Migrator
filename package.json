{
  "name": "sf-migrator-extension",
  "version": "1.0.0",
  "description": "Browser extension for migrating Salesforce data between orgs",
  "private": true,
  "scripts": {
    "build:extension": "tsc --project extension/tsconfig.json",
    "watch:extension": "tsc --project extension/tsconfig.json --watch",
    "build:server": "tsc --project server/tsconfig.json",
    "watch:server": "tsc --project server/tsconfig.json --watch",
    "build": "npm run build:extension && npm run build:server",
    "dev": "concurrently \"npm run watch:extension\" \"npm run watch:server\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "salesforce",
    "migration",
    "chrome-extension",
    "data-migration"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.11",
    "@types/jsforce": "^1.11.6",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@salesforce/core": "^8.32.6",
    "@salesforce/ts-types": "^2.0.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^5.4.1",
    "jsforce": "^3.10.16",
    "multer": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  }
}
