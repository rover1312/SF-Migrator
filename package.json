{
  "name": "sf-migrator",
  "version": "0.1.0",
  "description": "Local-first web app for configuring, extracting, validating, and migrating Salesforce data between orgs.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch src/server --ext ts --exec \"ts-node src/server/index.ts\"",
    "dev:client": "vite --config src/client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project src/server/tsconfig.json",
    "build:client": "vite build --config src/client/vite.config.ts",
    "start": "node src/server/dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --project src/server/tsconfig.json --noEmit",
    "typecheck:client": "tsc --project src/client/tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "keywords": [
    "salesforce",
    "migration",
    "local-first",
    "data-migration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "jsforce": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "axe-core": "^4.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.1.3",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
