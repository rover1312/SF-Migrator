# Copy this file to `.env` and fill in values. Never commit `.env`.
# Server
PORT=3001
NODE_ENV=development

# Salesforce OAuth (local callback)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Default login URLs (override per org in the UI)
SF_LOGIN_URL=https://login.salesforce.com
SF_TEST_LOGIN_URL=https://test.salesforce.com

# Local storage locations (defaults match PLAN.md)
DATA_DIR=./data
EXTRACTED_DIR=./data/extracted
CONFIGS_DIR=./data/configs
LOGS_DIR=./data/logs
TEMP_DIR=./data/temp
